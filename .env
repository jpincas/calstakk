# CalStakk configuration — committed defaults (non-secret).
#
# Precedence (first wins):  real shell env  >  .env.local  >  this file.
# Loaded by the `start`, `dev`, and `seed` deno tasks via --env-file.
# This file doubles as the canonical list of every var the server reads.

# ── Server ──
CALSTAKK_HOST=127.0.0.1
CALSTAKK_PORT=5232
CALSTAKK_WEB_DIR=web/dist
# CALSTAKK_KV_PATH=            # Deno KV path; empty = Deno's default location

# ── Owner / principal (the single user of this private server) ──
CALSTAKK_USERNAME=calstakk
CALSTAKK_DISPLAY_NAME=CalStakk
CALSTAKK_TIMEZONE=UTC
# CALSTAKK_EMAIL=             # owner email; used in scheduling (calendar-user-address-set)

# ── Secrets → set these in .env.local (gitignored), never here ──
# CALSTAKK_PASSWORD=          # set in .env.local to enable HTTP Basic Auth
