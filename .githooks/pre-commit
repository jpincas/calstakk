#!/usr/bin/env bash
# Pre-commit gate: type-check + lint + tests.
#
# To enable in a fresh clone, run once:
#   git config core.hooksPath .githooks
#
# This hook is checked into the repo on purpose: it travels with the project
# and matches the Claude Code Stop hook. Don't bypass with --no-verify; fix the failure.

set -euo pipefail

# The complete gate: backend lint + type-check + tests, then the web UI
# (lint + typecheck + build). One command, covers both halves.
~/.deno/bin/deno task check
