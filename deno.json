{
  "version": "0.1.0",
  "tasks": {
    "start": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env --env-file=.env.local --env-file=.env server.ts",
    "backend": "deno run --watch --unstable-kv --allow-net --allow-read --allow-write --allow-env --env-file=.env.local --env-file=.env server.ts",
    "dev": "bash scripts/dev.sh",
    "seed": "deno run --allow-net --allow-env --env-file=.env.local --env-file=.env scripts/seed.ts",
    "web-install": "cd web && npm ci --ignore-scripts",
    "web-dev": "cd web && npm run dev",
    "web-lint": "cd web && npm run lint",
    "web-build": "cd web && npm run build",
    "web-check": "cd web && npm run lint && npm run test && npm run build",
    "mcp": "deno run --allow-net --allow-env --env-file=.env.local --env-file=.env mcp/main.ts",
    "iterate": "deno check server.ts",
    "check": "deno lint && deno check server.ts mcp/main.ts && deno test --allow-net --allow-env tests/ && deno task web-check",
    "test": "deno test --allow-net --allow-env tests/",
    "conformance": "deno test --allow-net --allow-env tests/conformance/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1",
    "@/": "./web/src/",
    "rrule": "./mcp/vendor/rrule.ts",
    "rrule-npm": "npm:rrule@^2.8.1",
    "date-fns": "npm:date-fns@^4.1.0",
    "zod": "npm:zod@^4.0.0",
    "@xmldom/xmldom": "npm:@xmldom/xmldom@^0.9.8",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0"
  },
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable", "dom"]
  },
  "lint": {
    "exclude": ["web/", ".claude/"],
    "rules": {
      "exclude": ["no-explicit-any", "require-await"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2
  },
  "deploy": {
    "org": "jpincas",
    "app": "calstakk"
  }
}



































