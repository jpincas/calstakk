{
  "name": "calstakk",
  "version": "0.1.0",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env server.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env server.ts",
    "iterate": "deno check server.ts",
    "check": "deno lint && deno check server.ts && deno test --allow-net tests/",
    "test": "deno test --allow-net tests/",
    "conformance": "deno test --allow-net tests/conformance/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  },
  "lint": {
    "exclude": ["web/"],
    "rules": {
      "exclude": ["no-explicit-any", "require-await"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2
  }
}
