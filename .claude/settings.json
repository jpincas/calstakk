{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",

      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(ss:*)",

      "Bash(~/.deno/bin/deno check:*)",
      "Bash(~/.deno/bin/deno test:*)",
      "Bash(~/.deno/bin/deno lint:*)",
      "Bash(~/.deno/bin/deno run:*)",
      "Bash(~/.deno/bin/deno fmt:*)",
      "Bash(~/.deno/bin/deno cache:*)",

      "Bash(make web-install)",
      "Bash(make web-typecheck)",
      "Bash(make web-lint)",
      "Bash(make web-build)",

      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(npx shadcn:*)",
      "Bash(npx eslint:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)"
    ],
    "deny": [
      "Bash(git commit:--no-verify)",
      "Bash(git push:--force*)",
      "Bash(git push:-f*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/deny-bypass.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.deno/bin/deno check src/ tests/ 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
